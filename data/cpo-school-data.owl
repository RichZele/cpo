  <rdf:Description rdf:about="https://w3id.org/cpo/data">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="https://w3id.org/cpo"/>
    <rdfs:label xml:lang="en">CPO example data: a school building project</rdfs:label>
    <rdfs:comment xml:lang="en">The individuals of the worked example: one school building project, its building and spaces, the lighting requirement for classrooms, three luminaire types from a manufacturer catalogue, and the luminaires installed in the spaces.</rdfs:comment>
    <dcterms:creator>Rahel Kebede</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</dcterms:created>
    <owl:versionInfo>2.0</owl:versionInfo>
  </rdf:Description>
