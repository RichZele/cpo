<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/cpo#"
     xml:base="https://w3id.org/cpo"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/cpo">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</terms:created>
        <terms:creator>Rahel Kebede</terms:creator>
        <terms:description xml:lang="en">Building projects, their phases, the products installed in their buildings, and the requirements on their spaces. Worked example of TADS23, HT2026.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">Construction Project Typology Ontology (CPO)</terms:title>
        <vann:preferredNamespacePrefix>cpo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/cpo#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Building projects, their phases, the products installed in their buildings, and the requirements on their spaces. Worked example of TADS23, HT2026.</rdfs:comment>
        <rdfs:label xml:lang="en">Construction Project Typology Ontology (CPO)</rdfs:label>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/bot#containsElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bot#containsElement"/>
    


    <!-- https://w3id.org/cpo#follows -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#follows">
        <owl:inverseOf rdf:resource="https://w3id.org/cpo#precedes"/>
        <rdfs:label xml:lang="en">follows</rdfs:label>
        <skos:definition xml:lang="en">A phase follows another if it begins after the other ends. Inverse of precedes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasArea -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasArea">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/bot#Space"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:label xml:lang="en">has area</rdfs:label>
        <skos:definition xml:lang="en">The floor area of a space, a quantity value in square metre.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasBuilding -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasBuilding">
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Building"/>
        <rdfs:label xml:lang="en">has building</rdfs:label>
        <skos:definition xml:lang="en">Relates a building project to the building it delivers.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasLightingRequirement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasLightingRequirement">
        <rdfs:domain rdf:resource="https://w3id.org/bot#Space"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
        <rdfs:label xml:lang="en">has lighting requirement</rdfs:label>
        <skos:definition xml:lang="en">Relates a space to the lighting requirement that applies to it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasLuminousFlux -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasLuminousFlux">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:label xml:lang="en">has luminous flux</rdfs:label>
        <skos:definition xml:lang="en">The luminous flux of a luminaire type, a quantity value in lumen.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasPhase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasPhase">
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">has phase</rdfs:label>
        <skos:definition xml:lang="en">Relates a building project to one of its phases.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasProduct">
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#Product"/>
        <rdfs:label xml:lang="en">has product</rdfs:label>
        <skos:definition xml:lang="en">Relates a building project to a product installed in its building.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasProductType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasProductType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#ProductType"/>
        <rdfs:label xml:lang="en">has product type</rdfs:label>
        <skos:definition xml:lang="en">Relates an installed product to its type in the catalogue.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasRatedPower -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasRatedPower">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:label xml:lang="en">has rated power</rdfs:label>
        <skos:definition xml:lang="en">The rated power of a luminaire type, a quantity value in watt.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasRequiredIlluminance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasRequiredIlluminance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:label xml:lang="en">has required illuminance</rdfs:label>
        <skos:definition xml:lang="en">The maintained illuminance required on the task area, a quantity value in lux.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
        <rdfs:label xml:lang="en">has status</rdfs:label>
        <skos:definition xml:lang="en">Relates a building project to its current status. Functional: one status at a time.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#installedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#installedIn">
        <owl:inverseOf rdf:resource="https://w3id.org/bot#containsElement"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#Product"/>
        <rdfs:range rdf:resource="https://w3id.org/bot#Space"/>
        <rdfs:label xml:lang="en">installed in</rdfs:label>
        <skos:definition xml:lang="en">Relates a product to the space it is installed in. Inverse of bot:containsElement.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#isPhaseOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#isPhaseOf">
        <owl:inverseOf rdf:resource="https://w3id.org/cpo#hasPhase"/>
        <rdfs:label xml:lang="en">is phase of</rdfs:label>
        <skos:definition xml:lang="en">Relates a phase to the building project it belongs to. Inverse of hasPhase.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#isProductOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#isProductOf">
        <owl:inverseOf rdf:resource="https://w3id.org/cpo#hasProduct"/>
        <rdfs:label xml:lang="en">is product of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#precedes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#precedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">precedes</rdfs:label>
        <skos:definition xml:lang="en">A phase precedes another if it ends before the other begins. Transitive.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cpo#articleNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#articleNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#ProductType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">article number</rdfs:label>
        <skos:definition xml:lang="en">The manufacturer&apos;s article number of a product type.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#budget -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#budget">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">budget</rdfs:label>
        <skos:definition xml:lang="en">The allocated budget of the building project, in SEK.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#colourRenderingIndex -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#colourRenderingIndex">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">colour rendering index</rdfs:label>
        <skos:definition xml:lang="en">The colour rendering index Ra of a luminaire type.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#colourTemperature -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#colourTemperature">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">colour temperature</rdfs:label>
        <skos:definition xml:lang="en">The correlated colour temperature of a luminaire type, in kelvin.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#endDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#endDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">end date</rdfs:label>
        <skos:definition xml:lang="en">The date on which the building project is planned to be completed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#minColourRendering -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#minColourRendering">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">minimum colour rendering</rdfs:label>
        <skos:definition xml:lang="en">The minimum colour rendering index Ra.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#sourceStandard -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#sourceStandard">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">source standard</rdfs:label>
        <skos:definition xml:lang="en">The standard the requirement is taken from, such as EN 12464-1:2021.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#startDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#startDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">start date</rdfs:label>
        <skos:definition xml:lang="en">The date on which the building project begins.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#ugrLimit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#ugrLimit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">UGR limit</rdfs:label>
        <skos:definition xml:lang="en">The unified glare rating limit UGRL.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#uniformity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#uniformity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">uniformity</rdfs:label>
        <skos:definition xml:lang="en">The minimum illuminance uniformity Uo.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/QuantityValue -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue"/>
    


    <!-- http://w3id.org/CEON/ontology/resourceODP/Resource -->


    <owl:Class rdf:about="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
    


    <!-- https://w3id.org/bot#Building -->


    <owl:Class rdf:about="https://w3id.org/bot#Building"/>
    


    <!-- https://w3id.org/bot#Element -->


    <owl:Class rdf:about="https://w3id.org/bot#Element"/>
    


    <!-- https://w3id.org/bot#Space -->


    <owl:Class rdf:about="https://w3id.org/bot#Space"/>
    


    <!-- https://w3id.org/cpo#ActiveProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#ActiveProject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cpo#BuildingProject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/cpo#hasStatus"/>
                        <owl:hasValue rdf:resource="https://w3id.org/cpo#active"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">active project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose status is active.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#BuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#BuildingProject">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cpo#hasPhase"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProduct"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cpo#Product"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">building project</rdfs:label>
        <skos:definition xml:lang="en">A project that plans, designs, constructs and hands over a building.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#Classroom -->


    <owl:Class rdf:about="https://w3id.org/cpo#Classroom">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Space"/>
        <rdfs:label xml:lang="en">classroom</rdfs:label>
        <skos:definition xml:lang="en">A space for teaching.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#CommercialBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#CommercialBuildingProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:label xml:lang="en">commercial building project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose building is used for business, such as offices or shops.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#CommissionedFurnishedProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#CommissionedFurnishedProject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cpo#BuildingProject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/cpo#hasPhase"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#CommissioningPhase"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProduct"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#Furnishing"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">commissioned furnished project</rdfs:label>
        <skos:definition xml:lang="en">A building project with at least one furnishing that has reached its commissioning phase.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#CommissioningPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#CommissioningPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#PostConstructionPhase"/>
        <rdfs:label xml:lang="en">commissioning phase</rdfs:label>
        <skos:definition xml:lang="en">The part of the post-construction phase in which installed systems are tested and adjusted.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#ConstructionPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#ConstructionPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">construction phase</rdfs:label>
        <skos:definition xml:lang="en">The phase in which the building is built and the products are installed.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#Corridor -->


    <owl:Class rdf:about="https://w3id.org/cpo#Corridor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Space"/>
        <rdfs:label xml:lang="en">corridor</rdfs:label>
        <skos:definition xml:lang="en">A space for circulation between other spaces.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#DesignPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#DesignPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">design phase</rdfs:label>
        <skos:definition xml:lang="en">The phase in which the building and its products are designed and specified.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#EducationalBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#EducationalBuildingProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:label xml:lang="en">educational building project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose building is used for teaching, such as a school.</skos:definition>
