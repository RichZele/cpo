    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cpo#follows -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#follows">
        <owl:inverseOf rdf:resource="https://w3id.org/cpo#precedes"/>
        <rdfs:label xml:lang="en">follows</rdfs:label>
        <skos:definition xml:lang="en">A phase follows another if it begins after the other ends. Inverse of precedes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasPhase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasPhase">
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">has phase</rdfs:label>
        <skos:definition xml:lang="en">Relates a building project to one of its phases.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#hasStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#hasStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
        <rdfs:label xml:lang="en">has status</rdfs:label>
        <skos:definition xml:lang="en">Relates a building project to its current status. Functional: one status at a time.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#isPhaseOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#isPhaseOf">
        <owl:inverseOf rdf:resource="https://w3id.org/cpo#hasPhase"/>
        <rdfs:label xml:lang="en">is phase of</rdfs:label>
        <skos:definition xml:lang="en">Relates a phase to the building project it belongs to. Inverse of hasPhase.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cpo#precedes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cpo#precedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">precedes</rdfs:label>
        <skos:definition xml:lang="en">A phase precedes another if it ends before the other begins. Transitive.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cpo#budget -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#budget">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">budget</rdfs:label>
        <skos:definition xml:lang="en">The allocated budget of the building project, in SEK.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#endDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#endDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">end date</rdfs:label>
        <skos:definition xml:lang="en">The date on which the building project is planned to be completed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#startDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#startDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">start date</rdfs:label>
        <skos:definition xml:lang="en">The date on which the building project begins.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cpo#ActiveProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#ActiveProject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cpo#BuildingProject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/cpo#hasStatus"/>
                        <owl:hasValue rdf:resource="https://w3id.org/cpo#active"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">active project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose status is active.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#BuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#BuildingProject">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cpo#hasPhase"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">building project</rdfs:label>
        <skos:definition xml:lang="en">A project that plans, designs, constructs and hands over a building.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#CommercialBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#CommercialBuildingProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:label xml:lang="en">commercial building project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose building is used for business, such as offices or shops.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#CommissioningPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#CommissioningPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#PostConstructionPhase"/>
        <rdfs:label xml:lang="en">commissioning phase</rdfs:label>
        <skos:definition xml:lang="en">The part of the post-construction phase in which installed systems are tested and adjusted.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#ConstructionPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#ConstructionPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">construction phase</rdfs:label>
        <skos:definition xml:lang="en">The phase in which the building is built and the products are installed.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#DesignPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#DesignPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">design phase</rdfs:label>
        <skos:definition xml:lang="en">The phase in which the building and its products are designed and specified.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#EducationalBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#EducationalBuildingProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:label xml:lang="en">educational building project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose building is used for teaching, such as a school.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#HealthcareBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#HealthcareBuildingProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:label xml:lang="en">healthcare building project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose building is used for care, such as a hospital.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#IndustrialBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#IndustrialBuildingProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:label xml:lang="en">industrial building project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose building is used for production or storage.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#NonResidentialBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#NonResidentialBuildingProject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cpo#BuildingProject"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/cpo#ResidentialBuildingProject"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">non-residential building project</rdfs:label>
        <skos:definition xml:lang="en">A building project that is not a residential building project.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#PlanningPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#PlanningPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">planning phase</rdfs:label>
        <skos:definition xml:lang="en">The phase in which the need, the brief and the feasibility of the project are settled.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#PostConstructionPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#PostConstructionPhase">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
        <rdfs:label xml:lang="en">post-construction phase</rdfs:label>
        <skos:definition xml:lang="en">The phase after construction: commissioning and handover.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#ProjectPhase -->


    <owl:Class rdf:about="https://w3id.org/cpo#ProjectPhase">
        <rdfs:label xml:lang="en">project phase</rdfs:label>
        <skos:definition xml:lang="en">A period of a building project with its own purpose and deliverables.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#ProjectStatus -->


    <owl:Class rdf:about="https://w3id.org/cpo#ProjectStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cpo#active"/>
                    <rdf:Description rdf:about="https://w3id.org/cpo#completed"/>
                    <rdf:Description rdf:about="https://w3id.org/cpo#onHold"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">project status</rdfs:label>
        <skos:definition xml:lang="en">The state of a building project: active, on hold or completed.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#ResidentialBuildingProject -->


    <owl:Class rdf:about="https://w3id.org/cpo#ResidentialBuildingProject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
        <rdfs:label xml:lang="en">residential building project</rdfs:label>
        <skos:definition xml:lang="en">A building project whose building is used for housing.</skos:definition>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cpo#active -->


    <owl:NamedIndividual rdf:about="https://w3id.org/cpo#active">
        <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
        <rdfs:label xml:lang="en">active</rdfs:label>
        <skos:definition xml:lang="en">The status of a building project that is being carried out.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cpo#completed -->


    <owl:NamedIndividual rdf:about="https://w3id.org/cpo#completed">
        <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
        <rdfs:label xml:lang="en">completed</rdfs:label>
        <skos:definition xml:lang="en">The status of a building project that is finished.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cpo#onHold -->


    <owl:NamedIndividual rdf:about="https://w3id.org/cpo#onHold">
        <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
        <rdfs:label xml:lang="en">on hold</rdfs:label>
        <skos:definition xml:lang="en">The status of a building project that is paused.</skos:definition>
    </owl:NamedIndividual>
    


