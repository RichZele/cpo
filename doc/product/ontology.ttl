###  https://w3id.org/cpo#Fixture
<https://w3id.org/cpo#Fixture> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/cpo#Product> ;
                               owl:disjointWith <https://w3id.org/cpo#Furnishing> ;
                               rdfs:label "fixture"@en ;
                               <http://www.w3.org/2004/02/skos/core#definition> "A product fixed to the building, such as a luminaire."@en .


###  https://w3id.org/cpo#Furnishing
<https://w3id.org/cpo#Furnishing> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/cpo#Product> ;
                                  rdfs:label "furnishing"@en ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "A movable product, such as a desk or a chair."@en .


###  https://w3id.org/cpo#InteriorProduct
<https://w3id.org/cpo#InteriorProduct> rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Class ;
                                                             owl:unionOf ( <https://w3id.org/cpo#Furnishing>
                                                                           <https://w3id.org/cpo#Luminaire>
                                                                         )
                                                           ] ;
                                       rdfs:label "interior product"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A luminaire or a furnishing."@en .


###  https://w3id.org/cpo#Luminaire
<https://w3id.org/cpo#Luminaire> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/cpo#Fixture> ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://w3id.org/cpo#hasProductType> ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass <https://w3id.org/cpo#LuminaireType>
                                                 ] ;
                                 rdfs:label "luminaire"@en ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "light fitting"@en ,
                                                                                "lighting fixture"@en ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "One installed luminaire, at one place in one building."@en .


###  https://w3id.org/cpo#LuminaireType
<https://w3id.org/cpo#LuminaireType> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/cpo#ProductType> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/cpo#hasLuminousFlux> ;
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onClass <http://qudt.org/schema/qudt/QuantityValue>
                                                     ] ;
                                     rdfs:label "luminaire type"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "A luminaire article in a manufacturer catalogue."@en .


###  https://w3id.org/cpo#Product
<https://w3id.org/cpo#Product> rdf:type owl:Class ;
                               owl:disjointWith <https://w3id.org/cpo#ProductType> ;
                               rdfs:label "product"@en ;
                               <http://www.w3.org/2004/02/skos/core#definition> "One installed product in a building, from materials to finished goods."@en .


###  https://w3id.org/cpo#ProductType
<https://w3id.org/cpo#ProductType> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://w3id.org/CEON/ontology/resourceODP/Resource> ;
                                   rdfs:label "product type"@en ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "A product as described in a manufacturer catalogue: one article, many installed copies."@en .


