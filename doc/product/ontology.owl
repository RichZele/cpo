    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cpo#articleNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#articleNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#ProductType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">article number</rdfs:label>
        <skos:definition xml:lang="en">The manufacturer&apos;s article number of a product type.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#colourRenderingIndex -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#colourRenderingIndex">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">colour rendering index</rdfs:label>
        <skos:definition xml:lang="en">The colour rendering index Ra of a luminaire type.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cpo#colourTemperature -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cpo#colourTemperature">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">colour temperature</rdfs:label>
        <skos:definition xml:lang="en">The correlated colour temperature of a luminaire type, in kelvin.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/QuantityValue -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue"/>
    


    <!-- http://w3id.org/CEON/ontology/resourceODP/Resource -->


    <owl:Class rdf:about="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
    


    <!-- https://w3id.org/cpo#Fixture -->


    <owl:Class rdf:about="https://w3id.org/cpo#Fixture">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cpo#Furnishing"/>
        <rdfs:label xml:lang="en">fixture</rdfs:label>
        <skos:definition xml:lang="en">A product fixed to the building, such as a luminaire.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#Furnishing -->


    <owl:Class rdf:about="https://w3id.org/cpo#Furnishing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
        <rdfs:label xml:lang="en">furnishing</rdfs:label>
        <skos:definition xml:lang="en">A movable product, such as a desk or a chair.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#InteriorProduct -->


    <owl:Class rdf:about="https://w3id.org/cpo#InteriorProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cpo#Furnishing"/>
                    <rdf:Description rdf:about="https://w3id.org/cpo#Luminaire"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">interior product</rdfs:label>
        <skos:definition xml:lang="en">A luminaire or a furnishing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#Luminaire -->


    <owl:Class rdf:about="https://w3id.org/cpo#Luminaire">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Fixture"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProductType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cpo#LuminaireType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">luminaire</rdfs:label>
        <skos:altLabel xml:lang="en">light fitting</skos:altLabel>
        <skos:altLabel xml:lang="en">lighting fixture</skos:altLabel>
        <skos:definition xml:lang="en">One installed luminaire, at one place in one building.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#LuminaireType -->


    <owl:Class rdf:about="https://w3id.org/cpo#LuminaireType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProductType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cpo#hasLuminousFlux"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">luminaire type</rdfs:label>
        <skos:definition xml:lang="en">A luminaire article in a manufacturer catalogue.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#Product -->


    <owl:Class rdf:about="https://w3id.org/cpo#Product">
        <owl:disjointWith rdf:resource="https://w3id.org/cpo#ProductType"/>
        <rdfs:label xml:lang="en">product</rdfs:label>
        <skos:definition xml:lang="en">One installed product in a building, from materials to finished goods.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cpo#ProductType -->


    <owl:Class rdf:about="https://w3id.org/cpo#ProductType">
        <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
        <rdfs:label xml:lang="en">product type</rdfs:label>
        <skos:definition xml:lang="en">A product as described in a manufacturer catalogue: one article, many installed copies.</skos:definition>
    </owl:Class>
</rdf:RDF>



