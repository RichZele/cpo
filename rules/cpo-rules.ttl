uc:pr_70 a skos:Concept ;
    skos:inScheme uc:pr ;
    skos:notation "Pr_70"^^xsd:string ;
    skos:prefLabel "Services and process outlet products"@en ;
    skos:topConceptOf uc:pr .

uc:pr_70_70 a skos:Concept ;
    skos:broader uc:pr_70 ;
    skos:inScheme uc:pr ;
    skos:notation "Pr_70_70"^^xsd:string ;
    skos:prefLabel "Power and lighting outlet products"@en .

uc:pr_70_70_48_70 a skos:Concept ;
    skos:broader uc:pr_70_70_48 ;
    skos:inScheme uc:pr ;
    skos:notation "Pr_70_70_48_70"^^xsd:string ;
    skos:prefLabel "Recessed downlights"@en .

uc:sl_25 a skos:Concept ;
    skos:inScheme uc:sl ;
    skos:notation "SL_25"^^xsd:string ;
    skos:prefLabel "Cultural, educational, scientific and information spaces"@en ;
    skos:topConceptOf uc:sl .

uc:sl_25_10 a skos:Concept ;
    skos:broader uc:sl_25 ;
    skos:inScheme uc:sl ;
    skos:notation "SL_25_10"^^xsd:string ;
