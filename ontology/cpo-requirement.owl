<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/cpo/requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">CPO module: Requirement</rdfs:label>
    <rdfs:comment xml:lang="en">Lighting requirements for types of space, from a standard such as EN 12464-1:2021.</rdfs:comment>
    <dcterms:creator>Rahel Kebede</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</dcterms:created>
    <owl:versionInfo>2.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>cpo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/cpo#</vann:preferredNamespaceUri>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#LightingRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">lighting requirement</rdfs:label>
    <skos:definition xml:lang="en">The lighting a type of space must receive, as set by a standard such as EN 12464-1:2021.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="nf1056c9ef00c40838caedbb76b845fbbb1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ugrLimit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">UGR limit</rdfs:label>
    <skos:definition xml:lang="en">The unified glare rating limit UGRL.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#minColourRendering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">minimum colour rendering</rdfs:label>
    <skos:definition xml:lang="en">The minimum colour rendering index Ra.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasRequiredIlluminance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:label xml:lang="en">has required illuminance</rdfs:label>
    <skos:definition xml:lang="en">The maintained illuminance required on the task area, a quantity value in lux.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf1056c9ef00c40838caedbb76b845fbbb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasRequiredIlluminance"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#uniformity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">uniformity</rdfs:label>
    <skos:definition xml:lang="en">The minimum illuminance uniformity Uo.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#sourceStandard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source standard</rdfs:label>
    <skos:definition xml:lang="en">The standard the requirement is taken from, such as EN 12464-1:2021.</skos:definition>
  </rdf:Description>
</rdf:RDF>
