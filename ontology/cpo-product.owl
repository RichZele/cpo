<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasLuminousFlux"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#articleNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">article number</rdfs:label>
    <skos:definition xml:lang="en">The manufacturer's article number of a product type.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#colourRenderingIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">colour rendering index</rdfs:label>
    <skos:definition xml:lang="en">The colour rendering index Ra of a luminaire type.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#LuminaireType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdfs:subClassOf rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b5"/>
    <rdfs:label xml:lang="en">luminaire type</rdfs:label>
    <skos:definition xml:lang="en">A luminaire article in a manufacturer catalogue.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ProductType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
    <rdfs:label xml:lang="en">product type</rdfs:label>
    <skos:definition xml:lang="en">A product as described in a manufacturer catalogue: one article, many installed copies.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasRatedPower">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:label xml:lang="en">has rated power</rdfs:label>
    <skos:definition xml:lang="en">The rated power of a luminaire type, a quantity value in watt.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Fixture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
    <rdfs:label xml:lang="en">fixture</rdfs:label>
    <skos:definition xml:lang="en">A product fixed to the building, such as a luminaire.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#InteriorProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interior product</rdfs:label>
    <skos:definition xml:lang="en">A luminaire or a furnishing.</skos:definition>
    <owl:equivalentClass rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Furnishing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cpo#Fixture"/>
    <rdfs:label xml:lang="en">furnishing</rdfs:label>
    <skos:definition xml:lang="en">A movable product, such as a desk or a chair.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Luminaire">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Fixture"/>
    <rdfs:subClassOf rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b1"/>
    <rdfs:label xml:lang="en">luminaire</rdfs:label>
    <skos:altLabel xml:lang="en">light fitting</skos:altLabel>
    <skos:altLabel xml:lang="en">lighting fixture</skos:altLabel>
    <skos:definition xml:lang="en">One installed luminaire, at one place in one building.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProductType"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/cpo#LuminaireType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#colourTemperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">colour temperature</rdfs:label>
    <skos:definition xml:lang="en">The correlated colour temperature of a luminaire type, in kelvin.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasProductType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#Product"/>
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdfs:label xml:lang="en">has product type</rdfs:label>
    <skos:definition xml:lang="en">Relates an installed product to its type in the catalogue.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo/product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">CPO module: Product</rdfs:label>
    <rdfs:comment xml:lang="en">Installed products, their types from the manufacturer catalogue, and their quantities.</rdfs:comment>
    <dcterms:creator>Rahel Kebede</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</dcterms:created>
    <owl:versionInfo>2.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>cpo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/cpo#</vann:preferredNamespaceUri>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b3">
    <rdf:first rdf:resource="https://w3id.org/cpo#Luminaire"/>
    <rdf:rest rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">product</rdfs:label>
    <skos:definition xml:lang="en">One installed product in a building, from materials to finished goods.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/cpo#ProductType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n97f554e9961a46238f5bbdb3fc3cedf5b4">
    <rdf:first rdf:resource="https://w3id.org/cpo#Furnishing"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasLuminousFlux">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:label xml:lang="en">has luminous flux</rdfs:label>
    <skos:definition xml:lang="en">The luminous flux of a luminaire type, a quantity value in lumen.</skos:definition>
  </rdf:Description>
</rdf:RDF>
