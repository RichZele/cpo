  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#installedIn">
    <skos:definition xml:lang="en">Relates a product to the space it is installed in. Inverse of bot:containsElement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">installed in</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#Product"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bot#containsElement"/>
    <rdfs:range rdf:resource="https://w3id.org/bot#Space"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasPhase"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Furnishing">
    <rdfs:label xml:lang="en">furnishing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A movable product, such as a desk or a chair.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cpo#Fixture"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Luminaire">
    <rdfs:subClassOf rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Fixture"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en">light fitting</skos:altLabel>
    <skos:altLabel xml:lang="en">lighting fixture</skos:altLabel>
    <rdfs:label xml:lang="en">luminaire</rdfs:label>
    <skos:definition xml:lang="en">One installed luminaire, at one place in one building.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
