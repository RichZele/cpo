    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb26"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#InteriorProduct">
    <owl:equivalentClass rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interior product</rdfs:label>
    <skos:definition xml:lang="en">A luminaire or a furnishing.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#isPhaseOf">
    <skos:definition xml:lang="en">Relates a phase to the building project it belongs to. Inverse of hasPhase.</skos:definition>
    <owl:inverseOf rdf:resource="https://w3id.org/cpo#hasPhase"/>
    <rdfs:label xml:lang="en">is phase of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb10">
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb11"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb14">
    <rdf:first rdf:resource="https://w3id.org/cpo#DesignPhase"/>
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb15"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb18">
    <rdf:first rdf:resource="https://w3id.org/cpo#active"/>
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb19"/>
  </rdf:Description>
