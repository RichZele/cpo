  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <skos:definition xml:lang="en">Relates a building project to its current status. Functional: one status at a time.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
    <rdfs:label xml:lang="en">has status</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6233798837e14540ad77713499e9be9fb1">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasRequiredIlluminance"/>
    <owl:onClass rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ConstructionPhase">
    <rdfs:label xml:lang="en">construction phase</rdfs:label>
    <skos:definition xml:lang="en">The phase in which the building is built and the products are installed.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#sourceStandard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">source standard</rdfs:label>
    <skos:definition xml:lang="en">The standard the requirement is taken from, such as EN 12464-1:2021.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#PlanningPhase">
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <skos:definition xml:lang="en">The phase in which the need, the brief and the feasibility of the project are settled.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">planning phase</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b3">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProduct"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#Furnishing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasLuminousFlux">
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:definition xml:lang="en">The luminous flux of a luminaire type, a quantity value in lumen.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:label xml:lang="en">has luminous flux</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b1">
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProduct"/>
    <owl:onClass rdf:resource="https://w3id.org/cpo#Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#budget">
    <rdfs:label xml:lang="en">budget</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <skos:definition xml:lang="en">The allocated budget of the building project, in SEK.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#uniformity">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The minimum illuminance uniformity Uo.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:label xml:lang="en">uniformity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb7">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
