    <rdf:rest rdf:nodeID="nd39425121fae4370af3e5c091113d21cb11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb6">
    <rdf:rest rdf:nodeID="nd39425121fae4370af3e5c091113d21cb7"/>
    <rdf:first rdf:nodeID="nd39425121fae4370af3e5c091113d21cb3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b13">
    <rdf:first rdf:resource="https://w3id.org/cpo#PlanningPhase"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#EducationalBuildingProject">
    <skos:definition xml:lang="en">A building project whose building is used for teaching, such as a school.</skos:definition>
    <rdfs:label xml:lang="en">educational building project</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b3">
    <rdf:first rdf:resource="https://w3id.org/cpo#ResidentialBuildingProject"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b17">
    <owl:oneOf rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b18"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b1">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProductType"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
