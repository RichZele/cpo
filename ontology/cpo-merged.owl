  <rdf:Description rdf:about="https://w3id.org/cpo#DesignPhase">
    <rdfs:label xml:lang="en">design phase</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">The phase in which the building and its products are designed and specified.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#precedes">
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdfs:label xml:lang="en">precedes</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">A phase precedes another if it ends before the other begins. Transitive.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb4">
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb5"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#CommercialBuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasLightingRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has lighting requirement</rdfs:label>
    <skos:definition xml:lang="en">Relates a space to the lighting requirement that applies to it.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/bot#Space"/>
    <rdfs:range rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">One installed product in a building, from materials to finished goods.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Element"/>
    <rdfs:label xml:lang="en">product</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo">
    <dcterms:creator>Rahel Kebede</dcterms:creator>
    <owl:imports rdf:resource="https://w3id.org/bot#"/>
    <owl:versionInfo>2.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>cpo</vann:preferredNamespacePrefix>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Building projects, their phases, the products installed in their buildings, and the requirements on their spaces. Worked example of TADS23, HT2026.</rdfs:comment>
    <rdfs:comment xml:lang="en">This file is the merged ontology: the three modules and the composed ontology in one file.</rdfs:comment>
    <vann:preferredNamespaceUri>https://w3id.org/cpo#</vann:preferredNamespaceUri>
    <rdfs:label xml:lang="en">Construction Project Typology Ontology (CPO)</rdfs:label>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</dcterms:created>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#startDate">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">start date</rdfs:label>
    <skos:definition xml:lang="en">The date on which the building project begins.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasProduct">
    <rdfs:range rdf:resource="https://w3id.org/cpo#Product"/>
    <skos:definition xml:lang="en">Relates a building project to a product installed in its building.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has product</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#CommissioningPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">commissioning phase</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#PostConstructionPhase"/>
    <skos:definition xml:lang="en">The part of the post-construction phase in which installed systems are tested and adjusted.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasRequiredIlluminance">
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:label xml:lang="en">has required illuminance</rdfs:label>
    <skos:definition xml:lang="en">The maintained illuminance required on the task area, a quantity value in lux.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ProjectPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">project phase</rdfs:label>
    <skos:definition xml:lang="en">A period of a building project with its own purpose and deliverables.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Corridor">
    <skos:definition xml:lang="en">A space for circulation between other spaces.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">corridor</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Space"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b4">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#CommissioningPhase"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b11">
    <rdf:first rdf:resource="https://w3id.org/cpo#Product"/>
    <rdf:rest rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b12"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb9">
    <owl:complementOf rdf:resource="https://w3id.org/cpo#ResidentialBuildingProject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b5">
    <rdf:rest rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b6"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasProductType">
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdfs:label xml:lang="en">has product type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates an installed product to its type in the catalogue.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasRatedPower">
    <rdfs:label xml:lang="en">has rated power</rdfs:label>
    <skos:definition xml:lang="en">The rated power of a luminaire type, a quantity value in watt.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ProjectStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">project status</rdfs:label>
    <skos:definition xml:lang="en">The state of a building project: active, on hold or completed.</skos:definition>
    <owl:equivalentClass rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb17"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb20">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#completed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#colourRenderingIndex">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">colour rendering index</rdfs:label>
    <skos:definition xml:lang="en">The colour rendering index Ra of a luminaire type.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb13">
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb14"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#PlanningPhase"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Classroom">
    <skos:definition xml:lang="en">A space for teaching.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Space"/>
    <rdfs:label xml:lang="en">classroom</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b6">
    <rdf:rest rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b7"/>
    <rdf:first rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb11">
    <rdf:first rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb9"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b7">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb21">
    <owl:distinctMembers rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb22"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#onHold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
    <rdfs:label xml:lang="en">on hold</rdfs:label>
    <skos:definition xml:lang="en">The status of a building project that is paused.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#CommissionedFurnishedProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">commissioned furnished project</rdfs:label>
    <skos:definition xml:lang="en">A building project with at least one furnishing that has reached its commissioning phase.</skos:definition>
    <owl:equivalentClass rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b4">
    <rdf:first rdf:resource="https://w3id.org/cpo#Furnishing"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b1">
    <owl:onClass rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProductType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb3">
    <rdf:first rdf:resource="https://w3id.org/cpo#ResidentialBuildingProject"/>
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#LightingRequirement">
    <rdfs:label xml:lang="en">lighting requirement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n6233798837e14540ad77713499e9be9fb1"/>
    <skos:definition xml:lang="en">The lighting a type of space must receive, as set by a standard such as EN 12464-1:2021.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ResidentialBuildingProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <skos:definition xml:lang="en">A building project whose building is used for housing.</skos:definition>
    <rdfs:label xml:lang="en">residential building project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb15">
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb16"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#ConstructionPhase"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasBuilding">
    <rdfs:label xml:lang="en">has building</rdfs:label>
    <skos:definition xml:lang="en">Relates a building project to the building it delivers.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdfs:range rdf:resource="https://w3id.org/bot#Building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb24">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#completed"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b9">
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:rest rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ugrLimit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:label xml:lang="en">UGR limit</rdfs:label>
    <skos:definition xml:lang="en">The unified glare rating limit UGRL.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#EducationalBuildingProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">educational building project</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <skos:definition xml:lang="en">A building project whose building is used for teaching, such as a school.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b3"/>
  </rdf:Description>
