    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#PostConstructionPhase"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b5"/>
  </rdf:Description>
