  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb27"/>
  </rdf:Description>
</rdf:RDF>
