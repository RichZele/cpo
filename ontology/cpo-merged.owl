  <rdf:Description rdf:about="https://w3id.org/cpo#colourTemperature">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <skos:definition xml:lang="en">The correlated colour temperature of a luminaire type, in kelvin.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:label xml:lang="en">colour temperature</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#minColourRendering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">minimum colour rendering</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <skos:definition xml:lang="en">The minimum colour rendering index Ra.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#active">
    <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">The status of a building project that is being carried out.</skos:definition>
    <rdfs:label xml:lang="en">active</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#articleNumber">
    <skos:definition xml:lang="en">The manufacturer's article number of a product type.</skos:definition>
    <rdfs:label xml:lang="en">article number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#ProductType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#IndustrialBuildingProject">
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <skos:definition xml:lang="en">A building project whose building is used for production or storage.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">industrial building project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#LuminaireType">
    <skos:definition xml:lang="en">A luminaire article in a manufacturer catalogue.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b5"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdfs:label xml:lang="en">luminaire type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#CommercialBuildingProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A building project whose building is used for business, such as offices or shops.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdfs:label xml:lang="en">commercial building project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#PostConstructionPhase">
    <rdfs:label xml:lang="en">post-construction phase</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">The phase after construction: commissioning and handover.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ActiveProject">
    <skos:definition xml:lang="en">A building project whose status is active.</skos:definition>
    <owl:equivalentClass rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb25"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
