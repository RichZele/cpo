<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/cpo">
    <vann:preferredNamespaceUri>https://w3id.org/cpo#</vann:preferredNamespaceUri>
    <owl:versionInfo>2.0</owl:versionInfo>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</dcterms:created>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Building projects, their phases, the products installed in their buildings, and the requirements on their spaces. Worked example of TADS23, HT2026.</rdfs:comment>
    <rdfs:comment xml:lang="en">This file is the merged ontology: the three modules, the composed ontology and the reduced copy of BOT in one file.</rdfs:comment>
    <rdfs:label xml:lang="en">Construction Project Typology Ontology (CPO)</rdfs:label>
    <dcterms:creator>Rahel Kebede</dcterms:creator>
    <vann:preferredNamespacePrefix>cpo</vann:preferredNamespacePrefix>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#endDate">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">end date</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <skos:definition xml:lang="en">The date on which the building project is planned to be completed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ActiveProject">
    <rdfs:label xml:lang="en">active project</rdfs:label>
    <owl:equivalentClass rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b25"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A building project whose status is active.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Furnishing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
    <skos:definition xml:lang="en">A movable product, such as a desk or a chair.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/cpo#Fixture"/>
    <rdfs:label xml:lang="en">furnishing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#completed">
    <rdfs:label xml:lang="en">completed</rdfs:label>
    <skos:definition xml:lang="en">The status of a building project that is finished.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb3">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProduct"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#Furnishing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasLuminousFlux">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:label xml:lang="en">has luminous flux</rdfs:label>
    <skos:definition xml:lang="en">The luminous flux of a luminaire type, a quantity value in lumen.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b28">
    <rdf:first rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b26"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#BuildingProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="nd39425121fae4370af3e5c091113d21cb1"/>
    <rdfs:subClassOf rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b1"/>
    <skos:definition xml:lang="en">A project that plans, designs, constructs and hands over a building.</skos:definition>
    <rdfs:label xml:lang="en">building project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b26">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasStatus"/>
    <owl:hasValue rdf:resource="https://w3id.org/cpo#active"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb11">
    <rdf:first rdf:resource="https://w3id.org/cpo#Product"/>
    <rdf:rest rdf:nodeID="nd39425121fae4370af3e5c091113d21cb12"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#minColourRendering">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">minimum colour rendering</rdfs:label>
    <skos:definition xml:lang="en">The minimum colour rendering index Ra.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bot#hasSpace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has space</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/bot#"/>
    <rdfs:comment xml:lang="en">Relation to spaces contained in a zone. The typical domains of bot:hasSpace are instances of bot:Storey or bot:Building.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#isPhaseOf">
    <rdfs:label xml:lang="en">is phase of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cpo#hasPhase"/>
    <skos:definition xml:lang="en">Relates a phase to the building project it belongs to. Inverse of hasPhase.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#isProductOf">
    <rdfs:label xml:lang="en">is product of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cpo#hasProduct"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b8">
    <owl:intersectionOf rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b10"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b5">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasLuminousFlux"/>
    <owl:onClass rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#LuminaireType">
    <rdfs:subClassOf rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b5"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">luminaire type</rdfs:label>
    <skos:definition xml:lang="en">A luminaire article in a manufacturer catalogue.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bot#hasStorey">
    <rdfs:comment xml:lang="en">Relation to storeys contained in a zone. The typical domains of bot:hasStorey are instances of bot:Building.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/bot#"/>
    <rdfs:label xml:lang="en">has storey</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b2">
    <owl:members rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b14">
    <rdf:first rdf:resource="https://w3id.org/cpo#DesignPhase"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b15"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasBuilding">
    <rdfs:range rdf:resource="https://w3id.org/bot#Building"/>
    <rdfs:label xml:lang="en">has building</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates a building project to the building it delivers.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb12">
    <rdf:first rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdf:rest rdf:nodeID="nd39425121fae4370af3e5c091113d21cb13"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b15">
    <rdf:first rdf:resource="https://w3id.org/cpo#ConstructionPhase"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b16"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb7">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="nd39425121fae4370af3e5c091113d21cb4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#follows">
    <owl:inverseOf rdf:resource="https://w3id.org/cpo#precedes"/>
    <skos:definition xml:lang="en">A phase follows another if it begins after the other ends. Inverse of precedes.</skos:definition>
    <rdfs:label xml:lang="en">follows</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasPhase">
    <rdfs:label xml:lang="en">has phase</rdfs:label>
    <skos:definition xml:lang="en">Relates a building project to one of its phases.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nd39425121fae4370af3e5c091113d21cb5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#LightingRequirement">
    <rdfs:subClassOf rdf:nodeID="n7976fc02031b46e6a9d3c0a6e5c5ebc6b1"/>
    <skos:definition xml:lang="en">The lighting a type of space must receive, as set by a standard such as EN 12464-1:2021.</skos:definition>
    <rdfs:label xml:lang="en">lighting requirement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b19">
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b20"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#onHold"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Corridor">
    <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Space"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A space for circulation between other spaces.</skos:definition>
    <rdfs:label xml:lang="en">corridor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#colourTemperature">
    <rdfs:label xml:lang="en">colour temperature</rdfs:label>
    <skos:definition xml:lang="en">The correlated colour temperature of a luminaire type, in kelvin.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ProductType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A product as described in a manufacturer catalogue: one article, many installed copies.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
    <rdfs:label xml:lang="en">product type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasRequiredIlluminance">
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The maintained illuminance required on the task area, a quantity value in lux.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:label xml:lang="en">has required illuminance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#InteriorProduct">
    <rdfs:label xml:lang="en">interior product</rdfs:label>
    <skos:definition xml:lang="en">A luminaire or a furnishing.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Luminaire">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Fixture"/>
    <skos:definition xml:lang="en">One installed luminaire, at one place in one building.</skos:definition>
    <skos:altLabel xml:lang="en">light fitting</skos:altLabel>
    <skos:altLabel xml:lang="en">lighting fixture</skos:altLabel>
    <rdfs:label xml:lang="en">luminaire</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#colourRenderingIndex">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <skos:definition xml:lang="en">The colour rendering index Ra of a luminaire type.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">colour rendering index</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasRatedPower">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LuminaireType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <skos:definition xml:lang="en">The rated power of a luminaire type, a quantity value in watt.</skos:definition>
    <rdfs:label xml:lang="en">has rated power</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#onHold">
    <skos:definition xml:lang="en">The status of a building project that is paused.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">on hold</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ugrLimit">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">UGR limit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="en">The unified glare rating limit RUGL, as in EN 12464-1:2021.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#CommissioningPhase">
    <skos:definition xml:lang="en">The part of the post-construction phase in which installed systems are tested and adjusted.</skos:definition>
    <rdfs:label xml:lang="en">commissioning phase</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#PostConstructionPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#HealthcareBuildingProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A building project whose building is used for care, such as a hospital.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdfs:label xml:lang="en">healthcare building project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bot#containsElement">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/bot#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contains element</rdfs:label>
    <rdfs:comment xml:lang="en">Relation to a building element contained in a zone.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#articleNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <skos:definition xml:lang="en">The manufacturer's article number of a product type.</skos:definition>
    <rdfs:label xml:lang="en">article number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#ProductType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b24">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#completed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bot#Building">
    <rdfs:comment xml:lang="en">An independent unit of the built environment with a characteristic spatial structure, intended to serve at least one function or user activity [ISO 12006-2:2013]. A bot:Building is a part of the physical world or a virtual world that is inherently both located in this world and having a 3D spatial extent, is contained in a building site, and can contain one or more storeys that are vertically connected.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/bot#"/>
    <rdfs:label xml:lang="en">Building</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Product">
    <rdfs:label xml:lang="en">product</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Element"/>
    <skos:definition xml:lang="en">One installed product in a building, from materials to finished goods.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cpo#ProductType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b27"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bot#Space">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/bot#"/>
    <rdfs:comment xml:lang="en">A part of the physical world or a virtual world whose 3D spatial extent is bounded actually or theoretically, and provides for certain functions within the zone it is contained in.</rdfs:comment>
    <rdfs:label xml:lang="en">Space</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasProductType">
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProductType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has product type</rdfs:label>
    <skos:definition xml:lang="en">Relates an installed product to its type in the catalogue.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ResidentialBuildingProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <skos:definition xml:lang="en">A building project whose building is used for housing.</skos:definition>
    <rdfs:label xml:lang="en">residential building project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b27">
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b28"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#active">
    <skos:definition xml:lang="en">The status of a building project that is being carried out.</skos:definition>
    <rdfs:label xml:lang="en">active</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasStatus">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
    <skos:definition xml:lang="en">Relates a building project to its current status. Functional: one status at a time.</skos:definition>
    <rdfs:label xml:lang="en">has status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasLightingRequirement">
    <skos:definition xml:lang="en">Relates a space to the lighting requirement that applies to it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bot#Space"/>
    <rdfs:range rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:label xml:lang="en">has lighting requirement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#CommercialBuildingProject">
    <skos:definition xml:lang="en">A building project whose building is used for business, such as offices or shops.</skos:definition>
    <rdfs:label xml:lang="en">commercial building project</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b18">
    <rdf:first rdf:resource="https://w3id.org/cpo#active"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b19"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bot#Storey">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/bot#"/>
    <rdfs:comment xml:lang="en">A part of the physical world or a virtual world that is inherently both located in this world and having a 3D spatial extent. A bot:Storey is contained in one or more buildings, and is intended to contain one or more spaces that are horizontally connected. Storeys of a building are connected by means of vertical connections such as elevators and stairs. A bot:Storey encompasses both zones above and below ground, for example, a building with 21 floors above ground, one ground floor and 3 basements is equal to the sentence: A building has 25 instances of bot:Storey.</rdfs:comment>
    <rdfs:label xml:lang="en">Storey</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:label xml:lang="en">has area</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/bot#Space"/>
    <skos:definition xml:lang="en">The floor area of a space, a quantity value in square metre.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb5">
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:rest rdf:nodeID="nd39425121fae4370af3e5c091113d21cb6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bot#Element">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Building element</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/bot#"/>
    <rdfs:comment xml:lang="en">Constituent of a construction entity with a characteristic technical function, form or position [ISO 12006-2:2015, 3.4.7]</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#uniformity">
    <rdfs:label xml:lang="en">uniformity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <skos:definition xml:lang="en">The minimum illuminance uniformity Uo.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#IndustrialBuildingProject">
    <skos:definition xml:lang="en">A building project whose building is used for production or storage.</skos:definition>
    <rdfs:label xml:lang="en">industrial building project</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ProjectPhase">
    <rdfs:label xml:lang="en">project phase</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A period of a building project with its own purpose and deliverables.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasProduct"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/cpo#Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasProduct">
    <rdfs:range rdf:resource="https://w3id.org/cpo#Product"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdfs:label xml:lang="en">has product</rdfs:label>
    <skos:definition xml:lang="en">Relates a building project to a product installed in its building.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b23">
    <rdf:first rdf:resource="https://w3id.org/cpo#onHold"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b24"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#DesignPhase">
    <skos:definition xml:lang="en">The phase in which the building and its products are designed and specified.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">design phase</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb4">
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasPhase"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#CommissioningPhase"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b22"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7976fc02031b46e6a9d3c0a6e5c5ebc6b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasRequiredIlluminance"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#PostConstructionPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">post-construction phase</rdfs:label>
    <skos:definition xml:lang="en">The phase after construction: commissioning and handover.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b5">
    <rdf:first rdf:resource="https://w3id.org/cpo#IndustrialBuildingProject"/>
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#sourceStandard">
    <skos:definition xml:lang="en">The standard the requirement is taken from, such as EN 12464-1:2021.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source standard</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ProjectStatus">
    <owl:equivalentClass rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b17"/>
    <skos:definition xml:lang="en">The state of a building project: active, on hold or completed.</skos:definition>
    <rdfs:label xml:lang="en">project status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Fixture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A product fixed to the building, such as a luminaire.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
    <rdfs:label xml:lang="en">fixture</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#CommissionedFurnishedProject">
    <skos:definition xml:lang="en">A building project with at least one furnishing that has reached its commissioning phase.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="nd39425121fae4370af3e5c091113d21cb2"/>
    <rdfs:label xml:lang="en">commissioned furnished project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Classroom">
    <rdfs:label xml:lang="en">classroom</rdfs:label>
    <skos:definition xml:lang="en">A space for teaching.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Space"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#startDate">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <skos:definition xml:lang="en">The date on which the building project begins.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdfs:label xml:lang="en">start date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#installedIn">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#Product"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/bot#Space"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bot#containsElement"/>
    <skos:definition xml:lang="en">Relates a product to the space it is installed in. Inverse of bot:containsElement.</skos:definition>
    <rdfs:label xml:lang="en">installed in</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b3">
    <rdf:first rdf:resource="https://w3id.org/cpo#Luminaire"/>
    <rdf:rest rdf:nodeID="n8ff3d0cb326941d59cc332165800b7b4b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b16">
    <rdf:first rdf:resource="https://w3id.org/cpo#PostConstructionPhase"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#PlanningPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">planning phase</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <skos:definition xml:lang="en">The phase in which the need, the brief and the feasibility of the project are settled.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#budget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdfs:label xml:lang="en">budget</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="en">The allocated budget of the building project, in SEK.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <owl:onProperty rdf:resource="https://w3id.org/cpo#hasPhase"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ConstructionPhase">
    <skos:definition xml:lang="en">The phase in which the building is built and the products are installed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">construction phase</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b10">
    <rdf:rest rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b11"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#precedes">
    <rdfs:domain rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
    <rdfs:label xml:lang="en">precedes</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <skos:definition xml:lang="en">A phase precedes another if it ends before the other begins. Transitive.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/cpo#ProjectPhase"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd39425121fae4370af3e5c091113d21cb9">
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdf:rest rdf:nodeID="nd39425121fae4370af3e5c091113d21cb10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#NonResidentialBuildingProject">
    <rdfs:label xml:lang="en">non-residential building project</rdfs:label>
    <owl:equivalentClass rdf:nodeID="n37185a5e246141aab0a4e4a8ac7ba2e9b8"/>
    <skos:definition xml:lang="en">A building project that is not a residential building project.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
