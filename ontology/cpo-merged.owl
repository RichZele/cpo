    <rdf:rest rdf:nodeID="n9bdcd6d3ef884abfbbd28b7db13dceb0b4"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#Luminaire"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb27">
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb28"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#BuildingProject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n513913ec0c3145ab813b0a8238f5cc95b13">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/cpo#LightingRequirement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb19">
    <rdf:first rdf:resource="https://w3id.org/cpo#onHold"/>
    <rdf:rest rdf:nodeID="na8994a5bfd904167a9f6205c6a4f431cb20"/>
