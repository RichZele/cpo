  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#completed">
    <skos:definition xml:lang="en">The status of a building project that is finished.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cpo#ProjectStatus"/>
