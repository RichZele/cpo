  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cpo#BuildingProject"/>
    <rdfs:label xml:lang="en">end date</rdfs:label>
    <skos:definition xml:lang="en">The date on which the building project is planned to be completed.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#hasArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:domain rdf:resource="https://w3id.org/bot#Space"/>
    <skos:definition xml:lang="en">The floor area of a space, a quantity value in square metre.</skos:definition>
    <rdfs:label xml:lang="en">has area</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#follows">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cpo#precedes"/>
    <skos:definition xml:lang="en">A phase follows another if it begins after the other ends. Inverse of precedes.</skos:definition>
    <rdfs:label xml:lang="en">follows</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#ProductType">
    <skos:definition xml:lang="en">A product as described in a manufacturer catalogue: one article, many installed copies.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://w3id.org/CEON/ontology/resourceODP/Resource"/>
    <rdfs:label xml:lang="en">product type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cpo#Fixture">
    <skos:definition xml:lang="en">A product fixed to the building, such as a luminaire.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cpo#Product"/>
    <rdfs:label xml:lang="en">fixture</rdfs:label>
  </rdf:Description>
